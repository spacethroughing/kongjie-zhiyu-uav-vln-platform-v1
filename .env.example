HARNESS_HOST=127.0.0.1
HARNESS_PORT=8000
HARNESS_SCENES_FILE=configs/scenes.json
HARNESS_DATA_DIR=data
HARNESS_RUNS_DIR=runs
HARNESS_AIRSIM_CONDA_ENV=airsim
HARNESS_PROVIDER=mock

# OpenAI-compatible multimodal provider. The Web UI can override model/key
# for the current backend process without persisting or echoing the key.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.6v-flashx
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
